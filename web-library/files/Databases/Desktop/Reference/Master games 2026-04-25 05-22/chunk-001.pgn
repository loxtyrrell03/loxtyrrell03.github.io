[Event "Moscow Tal Memorial 6th"]
[Site "Moscow"]
[Date "2011.11.20"]
[Round "5"]
[White "Ivanchuk, Vassily"]
[Black "Carlsen, Magnus"]
[Result "1/2-1/2"]
[TimeControl "6000+30"]
